<Project>
  <!--
    Copy this file to ApiKeys.local.props and fill in your own keys.
    ApiKeys.local.props is git-ignored and must never be committed.
    The app builds and runs with empty values; Wallhaven, Bing and Spotlight
    work without any key, while Unsplash and Pixabay stay disabled.
  -->
  <PropertyGroup>
    <IcebergWallhavenKey></IcebergWallhavenKey>
    <IcebergUnsplashKey></IcebergUnsplashKey>
    <IcebergPixabayKey></IcebergPixabayKey>
  </PropertyGroup>
</Project>
