<Page
    x:Class="Lively.UI.WinUI.Views.Pages.FavouritesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Lively.UI.WinUI.ViewModels"
    Background="{x:Bind ViewModel.BackgroundBrush, Mode=OneWay}"
    RequestedTheme="{x:Bind ViewModel.ElementTheme, Mode=OneWay}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <DataTemplate x:Key="FavouriteTileTemplate" x:DataType="vm:FavouriteTile">
            <Grid
                Height="200"
                Margin="6"
                Tag="{x:Bind}"
                PointerEntered="Tile_PointerEntered"
                PointerExited="Tile_PointerExited"
                Tapped="Tile_Tapped">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="12">
                    <Grid>
                        <FontIcon
                            FontSize="26"
                            Glyph="&#xEB9F;"
                            Opacity="0.18" />

                        <Image
                            Source="{x:Bind Image, Mode=OneWay}"
                            Stretch="UniformToFill" />

                        <Border
                            Height="76"
                            VerticalAlignment="Bottom">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#00000000" />
                                    <GradientStop Offset="1" Color="#C0000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid
                            x:Name="HoverLayer"
                            Background="#33000000"
                            Opacity="0">
                            <Border
                                Padding="14,8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#D9000000"
                                CornerRadius="18">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontSize="13"
                                        Foreground="White"
                                        Glyph="&#xE890;" />
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="Preview" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel
                            Margin="12,0,12,10"
                            VerticalAlignment="Bottom"
                            Spacing="1">
                            <TextBlock
                                MaxLines="1"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{x:Bind Title}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                MaxLines="1"
                                FontSize="11"
                                Foreground="#CCFFFFFF"
                                Text="{x:Bind Subtitle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            Width="34"
                            Height="34"
                            Margin="8"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#66000000"
                            BorderThickness="0"
                            Click="Remove_Click"
                            CornerRadius="17"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="Remove from favourites">
                            <FontIcon
                                FontSize="14"
                                Foreground="White"
                                Glyph="&#xE735;" />
                        </Button>

                        <ProgressRing
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="{x:Bind IsApplying, Mode=OneWay}"
                            Visibility="{x:Bind IsApplying, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Padding="24,18,24,8"
            Spacing="2">
            <TextBlock
                FontSize="26"
                FontWeight="SemiBold"
                Foreground="{x:Bind ViewModel.TextBrush, Mode=OneWay}"
                Text="Favourites" />
            <TextBlock
                Foreground="{x:Bind ViewModel.TextBrush, Mode=OneWay}"
                Opacity="0.85"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer Padding="18,0,18,24">
                <ItemsRepeater
                    ItemTemplate="{StaticResource FavouriteTileTemplate}"
                    ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="0"
                            MinItemHeight="212"
                            MinItemWidth="240"
                            MinRowSpacing="0"
                            Orientation="Horizontal" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>

            <ProgressRing
                Width="40"
                Height="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel
                MaxWidth="380"
                Margin="0,100,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Spacing="10"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon
                    FontSize="34"
                    Foreground="{x:Bind ViewModel.TextBrush, Mode=OneWay}"
                    Glyph="&#xE734;"
                    Opacity="0.6" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{x:Bind ViewModel.TextBrush, Mode=OneWay}"
                    Opacity="0.85"
                    Text="Tap the star on any wallpaper in Home and it will wait for you here."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  Full-size preview. Sits over the list until closed.  -->
        <Grid
            Grid.RowSpan="2"
            Canvas.ZIndex="10"
            Background="#FF101014"
            Visibility="{x:Bind ViewModel.IsPreviewOpen, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                Padding="24,14,24,10"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="2">
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="{x:Bind ViewModel.PreviewTitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#B3FFFFFF"
                        Text="{x:Bind ViewModel.PreviewSubtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Background="#33FFFFFF"
                    BorderThickness="0"
                    Click="ClosePreview_Click"
                    CornerRadius="20"
                    ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon
                        FontSize="14"
                        Foreground="White"
                        Glyph="&#xE711;" />
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Escape" />
                    </Button.KeyboardAccelerators>
                </Button>
            </Grid>

            <Grid
                Grid.Row="1"
                Margin="24,0,24,6">
                <Image
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}"
                    Stretch="Uniform" />

                <ProgressRing
                    Width="44"
                    Height="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="#CCFFFFFF"
                    IsActive="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                <Border
                    Margin="0,0,0,8"
                    Padding="14,10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#CC2A1A1A"
                    CornerRadius="8"
                    Visibility="{x:Bind ViewModel.HasPreviewError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        MaxWidth="620"
                        Foreground="#FFFFB4B4"
                        Text="{x:Bind ViewModel.PreviewError, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Grid
                Grid.Row="2"
                Padding="24,8,24,18"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock
                        FontSize="11"
                        Foreground="#99FFFFFF"
                        Text="{x:Bind ViewModel.PreviewMeta, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="#FF9BE49B"
                        Text="{x:Bind ViewModel.PreviewNotice, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasPreviewNotice, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Width="40"
                        Height="40"
                        Padding="0"
                        Command="{x:Bind ViewModel.RemovePreviewCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="Remove from favourites">
                        <FontIcon FontSize="15" Glyph="&#xE735;" />
                    </Button>

                    <Button
                        Command="{x:Bind ViewModel.ApplyPreviewLockScreenCommand, Mode=OneWay}"
                        Content="Set lock screen"
                        IsEnabled="{x:Bind ViewModel.CanPreviewApply, Mode=OneWay}" />

                    <Button
                        Command="{x:Bind ViewModel.ApplyPreviewDesktopCommand, Mode=OneWay}"
                        Content="Set desktop"
                        IsEnabled="{x:Bind ViewModel.CanPreviewApply, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
