<Page
    x:Class="Lively.UI.WinUI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:Lively.UI.WinUI.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Page.Resources>

    <ScrollViewer
        x:Name="SettingsScroll"
        Padding="24,16,24,32"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled">
        <StackPanel
            MaxWidth="900"
            HorizontalAlignment="Center"
            Spacing="22">

            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="Settings" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Everything in one place. Changes are saved as you make them." />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasStatusMessage, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />

            <!--  Appearance: theme only  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Appearance" />

                <controls:SettingsCard
                    Description="System, light or dark."
                    Header="Theme">
                    <ComboBox
                        MinWidth="180"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="System" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </controls:SettingsCard>
            </StackPanel>

            <!--  Rotation  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Wallpaper rotation" />

                <controls:SettingsCard
                    Description="{x:Bind ViewModel.RotationSummary, Mode=OneWay}"
                    Header="Automatic wallpaper change">
                    <ComboBox
                        MinWidth="190"
                        SelectedIndex="{x:Bind ViewModel.RotationModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Time of the day" />
                        <ComboBoxItem Content="Timer" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard Header="Wallpaper rotation source">
                    <ComboBox
                        MinWidth="210"
                        SelectedIndex="{x:Bind ViewModel.RotationSourceIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Favourites" />
                        <ComboBoxItem Content="Predefined" />
                        <ComboBoxItem Content="Random" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Site"
                    Visibility="{x:Bind ViewModel.IsPredefinedSource, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <ComboBox
                        MinWidth="190"
                        ItemsSource="{x:Bind ViewModel.SiteNames, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.SiteIndex, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Collection"
                    Visibility="{x:Bind ViewModel.IsPredefinedSource, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <ComboBox
                        MinWidth="190"
                        ItemsSource="{x:Bind ViewModel.CollectionNames, Mode=OneWay}"
                        SelectedIndex="{x:Bind ViewModel.CollectionIndex, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Something bright in the day, something dark at night."
                    Header="Day time"
                    Visibility="{x:Bind ViewModel.IsTimeOfDayMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <TimePicker
                        ClockIdentifier="12HourClock"
                        Time="{x:Bind ViewModel.DayTime, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Night time"
                    Visibility="{x:Bind ViewModel.IsTimeOfDayMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <TimePicker
                        ClockIdentifier="12HourClock"
                        Time="{x:Bind ViewModel.NightTime, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="When the timer runs"
                    Visibility="{x:Bind ViewModel.IsTimerMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <ComboBox
                        MinWidth="210"
                        SelectedIndex="{x:Bind ViewModel.TimerModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Every day at midnight" />
                        <ComboBoxItem Content="Every 24 hours" />
                        <ComboBoxItem Content="Custom interval" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Custom interval"
                    Visibility="{x:Bind ViewModel.IsCustomTimer, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox
                            Width="120"
                            Header="Hours"
                            Maximum="168"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.CustomHours, Mode=TwoWay}" />
                        <NumberBox
                            Width="120"
                            Header="Minutes"
                            Maximum="59"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.CustomMinutes, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Videos are much larger downloads, so they stay out of the rotation until you allow them."
                    Header="Allow videos in rotation">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AllowVideoInRotation, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Change the Windows lock screen picture whenever the wallpaper rotates."
                    Header="Auto change in lock screen">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.RotateLockScreenToo, Mode=TwoWay}" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  Storage  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Downloaded pictures and videos" />

                <controls:SettingsCard
                    Description="{x:Bind ViewModel.CacheSummary, Mode=OneWay}"
                    Header="Clear downloaded files">
                    <Button Command="{x:Bind ViewModel.ClearCacheCommand, Mode=OneWay}" Content="Clear" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  Animated wallpapers: the whole card opens the page  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Animated wallpapers" />

                <controls:SettingsCard
                    Description="Which player is used and how much of the graphics card it may take."
                    Header="Player and performance"
                    Tag="settingsPerformance"
                    Tapped="Card_Tapped">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76C;" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Show your favourite pictures when the screen is idle."
                    Header="Screensaver"
                    Tag="settingsScreensaver"
                    Tapped="Card_Tapped">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76C;" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  About  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="About" />

                <controls:SettingsCard
                    Description="Version 1.0, credits and the licence."
                    Header="Iceberg Wallpapers"
                    Tag="about"
                    Tapped="Card_Tapped">
                    <FontIcon
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76C;" />
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
