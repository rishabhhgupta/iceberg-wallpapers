<Page
    x:Class="Lively.UI.WinUI.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:Lively.UI.WinUI.Helpers.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </Page.Resources>

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel
            MaxWidth="900"
            HorizontalAlignment="Left"
            Spacing="22">

            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="26"
                    FontWeight="SemiBold"
                    Text="Settings" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Everything in one place. Changes are saved as you make them." />
            </StackPanel>

            <TextBlock
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                TextWrapping="Wrap" />

            <!--  Appearance and behaviour  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Appearance and behaviour" />

                <controls:SettingsCard
                    Description="Light, dark or follow Windows, plus language, starting with Windows, the tray icon and reduced motion."
                    Header="Theme, language and startup">
                    <Button
                        Command="{x:Bind ViewModel.OpenPageCommand, Mode=OneWay}"
                        CommandParameter="settingsGeneral"
                        Content="Open" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="How the taskbar looks behind the wallpaper."
                    Header="Taskbar">
                    <Button
                        Command="{x:Bind ViewModel.OpenPageCommand, Mode=OneWay}"
                        CommandParameter="settingsWallpaper"
                        Content="Open" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  Rotation  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Wallpaper rotation" />

                <controls:SettingsCard
                    Description="{x:Bind ViewModel.RotationSummary, Mode=OneWay}"
                    Header="Change the wallpaper automatically">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.RotationEnabled, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Time of day changes twice a day; a timer counts the hours you choose."
                    Header="When should it change?">
                    <RadioButtons SelectedIndex="{x:Bind ViewModel.RotationModeIndex, Mode=TwoWay}">
                        <x:String>Time of day</x:String>
                        <x:String>Timer</x:String>
                    </RadioButtons>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Timer"
                    Visibility="{x:Bind ViewModel.IsTimerMode, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.TimerModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="Every day at midnight" />
                        <ComboBoxItem Content="Every 24 hours from the last change" />
                        <ComboBoxItem Content="Custom interval" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Header="Custom interval"
                    Visibility="{x:Bind ViewModel.IsCustomTimer, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox
                            Width="120"
                            Header="Hours"
                            Maximum="168"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.CustomHours, Mode=TwoWay}" />
                        <NumberBox
                            Width="120"
                            Header="Minutes"
                            Maximum="59"
                            Minimum="0"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.CustomMinutes, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Videos are much larger downloads, so they stay out of the rotation until you allow them."
                    Header="Allow videos and GIFs in rotation">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AllowVideoInRotation, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="{x:Bind ViewModel.NextChangeSummary, Mode=OneWay}"
                    Header="Next change">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RotationSummary, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="{x:Bind ViewModel.LockScreenSummary, Mode=OneWay}"
                    Header="Windows lock screen">
                    <StackPanel Spacing="8">
                        <Button Command="{x:Bind ViewModel.UseLastAsLockScreenCommand, Mode=OneWay}" Content="Use last wallpaper" />
                        <ToggleSwitch
                            Header="Change with rotation"
                            IsOn="{x:Bind ViewModel.RotateLockScreenToo, Mode=TwoWay}" />
                    </StackPanel>
                </controls:SettingsCard>
            </StackPanel>

            <!--  Storage  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Storage" />

                <controls:SettingsCard
                    Description="{x:Bind ViewModel.CacheSummary, Mode=OneWay}"
                    Header="Downloaded pictures and videos">
                    <Button Command="{x:Bind ViewModel.ClearCacheCommand, Mode=OneWay}" Content="Clear" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  Animated wallpapers  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="Animated wallpapers" />

                <controls:SettingsCard
                    Description="Which player is used and how much of the graphics card it may take."
                    Header="Player and performance">
                    <Button
                        Command="{x:Bind ViewModel.OpenPageCommand, Mode=OneWay}"
                        CommandParameter="settingsPerformance"
                        Content="Open" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="Use a Lively wallpaper as your Windows screensaver."
                    Header="Screensaver">
                    <Button
                        Command="{x:Bind ViewModel.OpenPageCommand, Mode=OneWay}"
                        CommandParameter="settingsScreensaver"
                        Content="Open" />
                </controls:SettingsCard>
            </StackPanel>

            <!--  Advanced, folded away  -->
            <Expander
                HorizontalAlignment="Stretch"
                Header="Advanced">
                <StackPanel Spacing="4">
                    <controls:SettingsCard
                        Description="The diagnostic window and the log files."
                        Header="Debug and logs">
                        <Button
                            Command="{x:Bind ViewModel.OpenPageCommand, Mode=OneWay}"
                            CommandParameter="settingsSystem"
                            Content="Open" />
                    </controls:SettingsCard>
                </StackPanel>
            </Expander>

            <!--  About  -->
            <StackPanel Spacing="4">
                <TextBlock
                    Margin="2,0,0,4"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="About" />

                <controls:SettingsCard
                    Description="Version 1.0, credits and the licence."
                    Header="Iceberg Wallpapers">
                    <Button
                        Command="{x:Bind ViewModel.OpenPageCommand, Mode=OneWay}"
                        CommandParameter="about"
                        Content="Open" />
                </controls:SettingsCard>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
